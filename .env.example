# Copy this file to .env (or export these as real environment variables) and
# fill in real values before deploying. Never commit your actual .env file.

# A long, random, unique string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-real-secret-key

# Set to false in production
DJANGO_DEBUG=true

# Comma-separated list of hostnames this site is served from
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,nayiraah.org,www.nayiraah.org

# Used to build canonical/OG URLs and default CSRF trusted origins
DJANGO_SITE_DOMAIN=nayiraah.org

# Only relevant in production (DJANGO_DEBUG=false)
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_CSRF_TRUSTED_ORIGINS=https://nayiraah.org,https://www.nayiraah.org

# Email (used to notify admins when the contact form is submitted)
# Leave DJANGO_EMAIL_BACKEND unset to use the console backend in debug mode.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.example.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=no-reply@nayiraah.org
DJANGO_EMAIL_HOST_PASSWORD=change-me
DJANGO_EMAIL_USE_TLS=true
DJANGO_DEFAULT_FROM_EMAIL=no-reply@nayiraah.org

# Comma-separated "Name:email" pairs who receive contact-form notifications
DJANGO_ADMINS=Niyati:you@example.com
